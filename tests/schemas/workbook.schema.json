{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/essential-eight-sentinel/schemas/workbook.schema.json",
  "title": "Azure Monitor / Microsoft Sentinel Workbook",
  "description": "Validates Microsoft Sentinel workbook JSON templates (Notebook/1.0).",
  "type": "object",
  "required": [
    "version",
    "items",
    "$schema"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "Notebook/1.0"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "content", "name"],
        "properties": {
          "type": {
            "type": "integer",
            "enum": [1, 3, 9, 10, 11, 12]
          },
          "content": { "type": "object" },
          "name": { "type": "string", "minLength": 1 },
          "conditionalVisibility": { "type": "object" },
          "conditionalVisibilities": { "type": "array" },
          "customWidth": { "type": "string" }
        }
      }
    },
    "isLocked": { "type": "boolean" },
    "fallbackResourceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fromTemplateId": { "type": "string" },
    "$schema": {
      "type": "string",
      "minLength": 1
    }
  }
}
